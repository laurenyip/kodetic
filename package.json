{
  "name": "kodetic",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "wrangler": "vendor/wrangler/cli.cjs"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "preview": "node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js preview",
    "deploy": "node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "upload": "node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js upload",
    "cf-typegen": "node ./vendor/wrangler/cli.cjs types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "import-media": "node scripts/import-media-kit.mjs",
    "river-thumbs": "node scripts/generate-river-thumbnails.mjs",
    "compress-images": "node scripts/compress-images.mjs",
    "grid-thumbs": "node scripts/generate-grid-thumbnails.mjs",
    "sync-river": "node scripts/sync-river-groups.mjs",
    "import-updated-media": "node scripts/import-updated-media-kit.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "15.5.25",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "file:vendor/wrangler"
  },
  "allowScripts": {
    "esbuild": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "unrs-resolver": true,
    "unrs-resolver@1.12.2": true,
    "workerd": true,
    "workerd@1.20260921.1": true
  }
}
